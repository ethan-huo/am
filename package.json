{
  "name": "am",
  "version": "0.1.1",
  "description": "Describe what am does in one line.",
  "bin": {
    "am": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "schema": "bun run src/main.ts @schema",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run fmt:check && bun run typecheck && bun test",
    "build": "bun build src/main.ts --outfile=dist/am --target=bun --minify && chmod +x dist/am"
  },
  "dependencies": {
    "@valibot/to-json-schema": "^1.7.0",
    "argc": "github:ethan-huo/argc#v7.7.0",
    "valibot": "^1.4.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.53.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
